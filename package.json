{
  "name": "gitgrove",
  "version": "0.1.0",
  "description": "A focused desktop Git client for repos, branches, worktrees, releases and pipelines",
  "main": "./out/main/index.js",
  "author": {
    "name": "GitGrove Contributors",
    "email": "hello@gitgrove.dev"
  },
  "license": "MIT",
  "homepage": "https://gitgrove.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitgrove/gitgrove.git"
  },
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "build:all": "npm run build && electron-builder --config electron-builder.config.cjs -mwl",
    "pack:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "icons": "bash scripts/make-icons.sh",
    "dist:flatpak": "bash scripts/build-flatpak.sh",
    "dist:snap": "bash scripts/build-snap.sh",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
