{
  "name": "gitgrove",
  "version": "0.1.0",
  "description": "A focused desktop Git client for repos, branches, worktrees, releases and pipelines",
  "main": "./out/main/index.js",
  "author": {
    "name": "GitGrove Contributors",
    "email": "hello@gitgrove.dev"
  },
  "license": "MIT",
  "homepage": "https://gitgrove.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitgrove/gitgrove.git"
  },
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux --x64 --arm64",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --arm64",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --x64 --arm64",
    "build:all": "npm run build && electron-builder --config electron-builder.config.cjs -mwl --x64 --arm64",
    "pack:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "icons": "bash scripts/make-icons.sh",
    "dist:flatpak": "bash scripts/build-flatpak.sh",
    "dist:snap": "bash scripts/build-snap.sh",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.0.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "42.11.16",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "desktopName": "gitgrove.desktop"
}
