<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fr.fradinni.Commit87</id>
  <name>Commit87</name>
  <summary>Focused desktop Git client</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Commit87 is a fast desktop Git client built on the system Git binary. It manages
      repositories, branches, worktrees, tags, releases and pipelines, and supports
      multiple Git identities for commits and pushes.
    </p>
    <ul>
      <li>Commit graph with staging, commit, amend and sign-off</li>
      <li>Branches, tags, stashes and worktrees</li>
      <li>Pull requests, releases and CI pipelines for GitHub, GitLab, Bitbucket and Gitea</li>
      <li>Per-repository identity and per-forge account mapping</li>
      <li>Built-in git console that runs git directly, without a shell</li>
    </ul>
  </description>
  <launchable type="desktop-id">fr.fradinni.Commit87.desktop</launchable>
